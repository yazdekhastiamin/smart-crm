PORT=4000

# Local demo: SQLite file on disk.
# Switching to Postgres later only needs this URL + the datasource
# provider in prisma/schema.prisma changed from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# نام شرکت فروشنده که روی خروجی پیش‌فاکتور (GET /api/deals/:id/export) درج می‌شود.
COMPANY_NAME="Smart CRM Demo"
