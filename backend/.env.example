PORT=4000

# Postgres connection string. On Railway this is provided automatically
# when a Postgres database is added to the project and referenced here as
# ${{Postgres.DATABASE_URL}} — never hardcode a real connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/smart_crm"

# نام شرکت فروشنده که روی خروجی پیش‌فاکتور (GET /api/deals/:id/export) درج می‌شود.
COMPANY_NAME="Smart CRM Demo"

# کلید Google Gemini API برای دستیار هوشمند (POST /api/assistant/chat).
# از aistudio.google.com/apikey بسازید. بدون این متغیر، دستیار پیام خطای
# فارسی مناسب برمی‌گرداند، نه کرش.
GEMINI_API_KEY=""
